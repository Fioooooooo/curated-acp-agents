  "curation": {
    "claude-acp": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Official ACP adapter for Claude, maintained in the agentclientprotocol org. Repo moved from zed-industries."
    },
    "cline": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "60k+ stars, active releases. Distributed as binary from the @cline/cli-* platform tarballs because the meta package's npx bin is broken upstream (bin name conflict with platform packages). ACP handshake verified without login.",
      "divergence": "Official registry distributes via npx cline@<version>; we ship platform binaries from the @cline/cli-* npm tarballs because the meta package's bin never links (bin name conflict). Same upstream version, same --acp entrypoint."
    },
    "codebuddy-code": {
      "tier": 2,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Tencent Cloud official CLI with --acp support. Proprietary, no public source repo; version tracking via npm. ACP handshake verified without login."
    },
    "codex-acp": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Official ACP adapter for OpenAI Codex, maintained in the agentclientprotocol org. Old zed-industries repo is archived; npx-only distribution."
    },
    "cursor": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Cursor's official CLI with a native 'agent acp' ACP server. Binary-only distribution via downloads.cursor.com; no public source repo or upstream-published archive digest.",
      "divergence": "Same archives as the official registry entry, but the version keeps the full build hash as a semver prerelease ('2026.8.11-e8db854' vs official '2026.08.11') so every archive URL stays version-pinned and reproducible."
    },
    "gemini": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Google's official CLI, 100k+ stars, active releases, ACP via --acp."
    },
    "github-copilot-cli": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "GitHub's official Copilot CLI (@github/copilot) with --acp support, active releases. Entry aligned with the official registry's github-copilot-cli (same ID and package)."
    },
    "goose": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Block's open source agent, 50k+ stars, repo moved to aaif-goose org, native acp subcommand."
    },
    "kimi-code": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Successor to the Python kimi-cli (being wound down upstream). Node.js rewrite, native 'kimi acp' subcommand, active releases."
    },
    "mistral-vibe": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Mistral's official open source assistant, ships dedicated vibe-acp binaries."
    },
    "opencode": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Most-starred open source coding agent, active releases, native acp subcommand."
    },
    "qoder": {
      "tier": 2,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Qoder AI CLI with --acp support. Proprietary, no public source repo; version tracking via npm. ACP handshake verified without login."
    },
    "qwen-code": {
      "tier": 1,
      "status": "active",
      "added": "2026-08-20",
      "reason": "Alibaba's official Qwen coding CLI, active releases, ACP via --acp."
    }
  }
